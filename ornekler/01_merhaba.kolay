// İlk program: ekrana yazma, kullanıcıdan bilgi alma ve hataları yakalama
// Çalıştırmak için:  kolay 01_merhaba.kolay
// Derlemek için:     kolay derle 01_merhaba.kolay

yazdır("Merhaba dünya!")

değişken ad = oku("Adınız nedir? ")
yazdır(f"Merhaba {ad}!")

// tama() yazıyı sayıya çevirir; sayı yazılmadıysa hata verir. Hata 'yakala' ile ele alınır.
dene {
    değişken yaş = oku("Kaç yaşındasınız? ").tama()
    yazdır(f"10 yıl sonra {yaş + 10} yaşında olacaksınız.")
} yakala h: Hata.Dönüşüm {
    yazdır("Yaşınızı sayıyla yazmalısınız:", h.mesaj)
}
