// İlk program: ekrana yazma ve kullanıcıdan bilgi alma
// Çalıştırmak için:  kolay 01_merhaba.kolay
// Derlemek için:     kolay derle 01_merhaba.kolay

yazdır("Merhaba dünya!")

ata ad = oku("Adınız nedir? ")
ata yaş = oku("Kaç yaşındasınız? ").tama()

yazdır(f"Merhaba {ad}! 10 yıl sonra {yaş + 10} yaşında olacaksınız.")
