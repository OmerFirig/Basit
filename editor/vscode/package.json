{
  "name": "kolay",
  "displayName": "Kolay",
  "description": "Kolay (Türkçe programlama dili): renklendirme, tamamlama, hata gösterme ve çalıştırma",
  "version": "0.5.0",
  "publisher": "kolay",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kolay",
        "aliases": [
          "Kolay",
          "kolay"
        ],
        "extensions": [
          ".kolay"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kolay",
        "scopeName": "source.kolay",
        "path": "./syntaxes/kolay.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "kolay",
        "path": "./snippets/kolay.json"
      }
    ],
    "commands": [
      {
        "command": "kolay.calistir",
        "title": "Kolay: Çalıştır",
        "icon": "$(play)"
      },
      {
        "command": "kolay.derle",
        "title": "Kolay: Derle"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "kolay.calistir",
          "when": "editorLangId == kolay",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kolay.calistir",
        "key": "f5",
        "when": "editorLangId == kolay"
      }
    ],
    "configuration": {
      "title": "Kolay",
      "properties": {
        "kolay.yol": {
          "type": "string",
          "default": "",
          "description": "kolay programının yolu (boşsa PATH'teki 'kolay')"
        }
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://example.invalid/kolay"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:kolay"
  ]
}
