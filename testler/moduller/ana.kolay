m adıyla dahil et("./matematik.kolay")
dahil et("./yardimci.kolay")
yazdır(m.topla(2, 3), m.pi)
değişken n: m.Nokta = m.Nokta(x: 1, y: 2)
n.göster()
selamla("Ali")
yazdır(sayi, topla(1, 1))
değişken kap = m.Kap(içerik: "modül")
değişken kap2: m.Kap<Yazı> = kap
yazdır(kap2.al(), m.ilk([4, 5]), kap)
fonksiyon uygula(f: Fonksiyon(Tam(64)) -> Tam(64), x: Tam(64)) -> Tam(64) { döndür f(x) }
yazdır(m.üçle(2), m.üçle(1.5), uygula(m.üçle, 4), uygula(m.kendisi, 9))
