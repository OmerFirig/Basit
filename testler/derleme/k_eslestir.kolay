fonksiyon tür_adı(x: Tam(64)) -> Yazı {
    döndür eşleştir x {
        0..=12 -> "çocuk"
        13..=17 -> "genç"
        18 veya 65 -> "özel"
        değilse -> f"yetişkin {x}"
    }
}
(ata i = 0; i <= 70; i += 13) sürece yap { yazdır(tür_adı(i)) }
ata s = "elma"
eşleştir s.büyük_harf() {
    "ELMA" -> yazdır("elma!")
    değilse -> yazdır("başka")
}
ata m = doğru
ata r = eşleştir m { doğru -> 1, yanlış -> 2 }
yazdır(r)
