tür Kutu<T>(değer: T) {
    fonksiyon al() -> T { döndür değer }
    fonksiyon koy(yeni: T) { değer = yeni }
    fonksiyon eşit(diğer: Kutu<T>) -> Mantık { döndür değer == diğer.değer }
}

değişken k = Kutu(değer: 5)
yazdır(k, k.al())
k.koy(7)
yazdır(k.değer)
değişken y = Kutu("merhaba")
yazdır(y.al(), y)
değişken s: Kutu<Tam(8)> = Kutu(değer: 3)
yazdır(s)
yazdır(k.eşit(Kutu(değer: 7)))

tür Çift<A, B>(ilk: A, ikinci: B) {
    fonksiyon ters() -> Çift<B, A> { döndür Çift(ilk: ikinci, ikinci: ilk) }
}
değişken ç = Çift(1, "bir")
yazdır(ç, ç.ters())

tür Yığın<T>(elemanlar: Liste<T>) {
    fonksiyon ekle(x: T) { elemanlar.ekle(x) }
    fonksiyon çıkar() -> T { döndür elemanlar.çıkar() }
    fonksiyon boş_mu() -> Mantık { döndür elemanlar.uzunluk() == 0 }
}
değişken yığın = Yığın([] olarak Liste<Yazı>)
yığın.ekle("a")
yığın.ekle("b")
yazdır(yığın.çıkar(), yığın)

fonksiyon kutula<T>(x: T) -> Kutu<T> { döndür Kutu(değer: x) }
fonksiyon aç<T>(k: Kutu<T>) -> T { döndür k.değer }
yazdır(aç(kutula(2.5)), aç(Kutu(doğru)))

tür Düğüm<T>(değer: T, sonraki: Düğüm<T> veya Hiç)
değişken liste = Düğüm(1, Düğüm(2, Hiç))
yazdır(liste)

değişken kutular: Liste<Kutu<Yazı>> = [Kutu("x"), Kutu("y")]
yazdır(kutular)
tür Sahip(kutu: AdlıKutu<Tam>)      // AdlıKutu henüz tanımlanmadı
arayüz Adlı { fonksiyon ad() -> Yazı }
tür Temel(no: Tam(64)) { fonksiyon tanıt() { yazdır(f"no {no}") } }
tür AdlıKutu<T>[Temel, Adlı](değer: T) {
    fonksiyon ad() -> Yazı { döndür f"kutu({değer})" }
    fonksiyon dönüştür(f: Fonksiyon(T) -> T) { değer = f(değer) }
}
değişken s = Sahip(kutu: AdlıKutu(no: 1, değer: 10))
yazdır(s)
s.kutu.tanıt()
değişken a: Adlı = AdlıKutu(2, "x")
yazdır(a.ad())
değişken kk = AdlıKutu(3, 2.5)
kk.dönüştür(her x için x * 2)
yazdır(kk.değer)
değişken liste: Liste<Adlı> = [AdlıKutu(4, 1), AdlıKutu(5, "b")]
liste içindeki her e için yap { yazdır(e.ad()) }
değişken v: AdlıKutu<Tam(64)> veya Yazı = AdlıKutu(6, 7)
eşleştir v {
    b: AdlıKutu<Tam(64)> -> yazdır("kutu", b.değer)
    y: Yazı -> yazdır(y)
}
değişken f = liste.dönüşüm(her x için AdlıKutu(0, x.ad()))
yazdır(f)
// taşma generic türün metodunda
tür Sayaç<T>(n: T) { fonksiyon artır() { n += 100 } }
değişken sy: Sayaç<Tam(8)> = Sayaç(n: 100)
sy.artır()
