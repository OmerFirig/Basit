seçenek S { A, B(x: Tam(64)) }
ata a: Liste<S>[2]
ata b: Liste<Yazı>[2]
ata c: Liste<Liste<Tam(64)>>[2]
ata d: Liste<Tam(64) veya Yazı>[2]
ata e: Liste<Sözlük<Yazı, Tam(64)>>[1]
c[0].ekle(1)
e[0]["k"] = 1
yazdır(a, b, c, d, e)
ata f: Liste<Tam(64)>[3][2]
f[2][1] = 9
yazdır(f, f[2], f[-1][-1])
ata g = [1, 2, 3, 4, 5]
yazdır(g[-2..], g[1..=3], g[..-1], g[10..], g[3..1])
