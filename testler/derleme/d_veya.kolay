değişken t: Liste<Tam(64) veya Yazı veya Hiç> = [1, "iki", Hiç, 4]
t içindeki her e için yap {
    eşleştir e {
        Tam(n) -> yazdır(n * 10)
        Yazı(y) -> yazdır(y.büyük_harf())
        Hiç -> yazdır("boş")
    }
}
yazdır(t)
değişken x: Tam(8) veya Ondalık(32) = 5
yazdır(x)
x = 2.5
yazdır(x)
değişken y: Tam(64) veya Ondalık(32) veya Yazı = 7
yazdır(y)
değişken z: Tam(8) veya Yazı = 3
değişken w: Tam(64) veya Yazı veya Mantık = z
yazdır(w)
değişken sayi = w olarak Tam(64)
yazdır(sayi + 1)
değişken l = [5, 6, 7]
değişken i = l.bul(6)
yazdır(i)
eşleştir l.bul(9) {
    Tam(n) -> yazdır("buldu", n)
    Hiç -> yazdır("yok")
}
değişken r = eşleştir i { Tam(n) -> n, Hiç -> -1 }
yazdır(r)
