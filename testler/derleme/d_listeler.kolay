değişken l: Liste<Yazı> = ["c", "a", "b"]
l.sırala()
l.araya_ekle(0, "z")
l.ekle("ş")
yazdır(l, l.uzunluk(), l[-1], l[1..3], l[..2], l[2..])
yazdır(l.çıkar(), l)
l.sil(0)
l.ters_çevir()
yazdır(l, l.bul("b"), l.içerir("q"))
