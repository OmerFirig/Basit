// generic lambda
değişken iki_kat = her<T> x: T için x * 2
yazdır(iki_kat(5), iki_kat(2.5))
değişken topla = her<T> (a: T, b: T) için a + b
yazdır(topla(1, 2), topla("a", "b"))
değişken artır = her x: Tam(64) için x + 1
yazdır(artır(41))

// somut tip beklenen yere verilince orada somutlaşır
fonksiyon uygula(f: Fonksiyon(Tam(64)) -> Tam(64), x: Tam(64)) -> Tam(64) { döndür f(x) }
fonksiyon kare<T>(x: T) -> T { döndür x * x }
yazdır(uygula(iki_kat, 5), uygula(kare, 7), uygula(artır, 1))
değişken g: Fonksiyon(Ondalık) -> Ondalık = kare
yazdır(g(1.5))
yazdır([1, 2, 3].dönüşüm(iki_kat), [1.5, 2.5].dönüşüm(kare), ["a", "b"].dönüşüm(iki_kat_yazı))
fonksiyon iki_kat_yazı(s: Yazı) -> Yazı { döndür s + s }
yazdır([3, 1, 2].dönüşüm(her<T> x: T için x * 10))

// generic fonksiyon alan generic fonksiyon
fonksiyon uygula2<T>(f: Fonksiyon(T) -> T, x: T) -> T { döndür f(x) }
yazdır(uygula2(kare, 3), uygula2(iki_kat, 1.25))

// parametre her tiple çalışan fonksiyon olabilir
fonksiyon ikisine(f: Fonksiyon<T>(T) -> T) {
    yazdır(f(5), f(2.5))
}
ikisine(iki_kat)
ikisine(kare)
ikisine(her<T> x: T için x + x + x)
fonksiyon zincir(f: Fonksiyon<T>(T) -> T, g: Fonksiyon<T>(T) -> T, n: Tam(64)) -> Tam(64) { döndür g(f(n)) }
yazdır(zincir(kare, iki_kat, 3))
fonksiyon içinden(f: Fonksiyon<T>(T) -> T) { ikisine(f) }
içinden(kare)

// normal fonksiyon ve lambda değerleri
değişken h = iki_kat_yazı
değişken l = her (x: Tam(64)) için x - 1
fonksiyon çağır(f: Fonksiyon(Tam(64)) -> Tam(64)) -> Tam(64) { döndür f(10) }
yazdır(h("x"), l(5), çağır(l), çağır(her x için x * 3))
değişken fs = [l, artır, her (y: Tam(64)) için y * y]
yazdır(fs.dönüşüm(her f için f(4)))

// generic lambda başka generic lambdayı kullanabilir
değişken iki = her<T> x: T için x * 2
değişken dört = her<T> x: T için iki(iki(x))
yazdır(dört(3), dört(1.5))
// yazı indeksi ve Python gibi ondalık yazımı
değişken s = "çiçek"
yazdır(s[0], s[-1], 1.5e-7, 6.022e23, 1e16, 1e15, 0.0001)
// ortak fonksiyon değer olarak
tür Hesap(n: Tam(64)) {
    ortak fonksiyon iki(x: Tam(64)) -> Tam(64) { döndür x * 2 }
}
yazdır(uygula(Hesap.iki, 6), [1, 2].dönüşüm(Hesap.iki))
