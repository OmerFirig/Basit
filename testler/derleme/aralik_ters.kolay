// Ters aralıklar ve adım (aralık bir listedir; adım listenin adım metoduyla aynı: eksi adım sondan başlar)
ata t = ""
5..0 içindeki her i için yap { t += f"{i} " }
yazdır(t)
t = ""
5..=0 içindeki her i için yap { t += f"{i} " }
yazdır(t)
t = ""
(10..0).adım(-3) içindeki her i için yap { t += f"{i} " }
yazdır(t)
t = ""
(10..=1).adım(-3) içindeki her i için yap { t += f"{i} " }
yazdır(t)
t = ""
(0..10).adım(3) içindeki her i için yap { t += f"{i} " }
yazdır(t)
ata a = 3
ata b = -2
t = ""
a..b içindeki her i için yap { t += f"{i} " }
yazdır(t)
t = ""
(a..=b).adım(-2) içindeki her i için yap {
    eğer i == 1 { devam }
    t += f"{i} "
}
yazdır(t)
t = ""
4..4 içindeki her i için yap { t += "x" }
4..=4 içindeki her i için yap { t += "y" }
(4..=4).adım(-5) içindeki her i için yap { t += "z" }
yazdır(t)
ata r = 9..2
yazdır(r, (9..2).adım(-2), 2..9, (2..9).adım(2), (9..2).adım(-1))
ata bb = 9223372036854775807
t = ""
(bb - 2..=bb).adım(1) içindeki her i için yap { t += f"{i} " }
yazdır(t)
t = ""
(-9223372036854775807 - 1 + 2..=-9223372036854775807 - 1) içindeki her i için yap { t += f"{i} " }
yazdır(t)
t = ""
(0..9223372036854775807).adım(4611686018427387904) içindeki her i için yap { t += f"{i} " }
yazdır(t)
ata l = [1, 2, 3, 4, 5]
yazdır(l[3..1], l[..-1], l[-2..])
yazdır(r == 9..2, r == (9..2).adım(-1), r == (9..2).adım(-2))
// sınırların uç değerleri: taşma olmadan
t = ""
(9223372036854775807..=-9223372036854775807 - 1).adım(9223372036854775807) içindeki her i için yap { t += f"{i} " }
yazdır(t)
(3..0).adım(0) içindeki her i için yap { }
