değişken x: Tam(64) veya Yazı veya Hiç = "a"
değişken y: Yazı veya Hiç = x olarak Yazı
yazdır(y)
değişken l: Liste<Tam(64) veya Ondalık(32) veya Yazı> = [1, 0.1, "x"]
yazdır(l, l[1])
değişken eşit = l == l
yazdır(eşit, l[0] == 1, l[2] == "x")
değişken d: Sözlük<Yazı, Tam(8) veya Liste<Yazı>> = {"a": 1}
d["b"] = ["x", "y"]
yazdır(d)
değişken z: Tam(8) veya Yazı = 3
değişken w: Tam veya Yazı = z
yazdır(w, w olarak Tam)
fonksiyon f(v: Tam(64) veya Yazı) -> Yazı {
    döndür eşleştir v { Tam(n) -> f"sayı {n}", Yazı(s) -> f"yazı {s}" }
}
yazdır(f(4), f("dört"))
değişken hl: Liste<Yazı veya Hiç>[3]
hl[1] = "orta"
yazdır(hl)
