tür Kutu<T>(değer: T) {
    ortak değişken sayı = 0
    ortak sabit AD = "kutu"
    fonksiyon say() { sayı += 1 }
    fonksiyon göster() -> Yazı { döndür f"{AD} #{sayı}: {değer}" }
    ortak fonksiyon rapor() -> Yazı { döndür f"{sayı} {AD}" }
}
değişken a = Kutu(5)
değişken b = Kutu("x")
a.say()
b.say()
b.say()
yazdır(a.göster(), b.göster())
yazdır(Kutu.sayı, Kutu.rapor())
Kutu.sayı = 0
yazdır(Kutu.rapor())
