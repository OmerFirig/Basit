// Tam sayılar, ondalıklar, taşma ve dönüştürme
değişken a: Tam(8) = 100
değişken b: Tam(8, +) = 200
değişken c: Tam(8, -) = -200
değişken d: Tam(+) = 5
değişken y = 42
değişken z: Tam = 1
100 kere yap { z = z * 2 }
yazdır(a, b, c, d, y)
yazdır(z)
değişken o = 3.14
değişken o32: Ondalık(32) = 3.14
değişken o16: Ondalık(16) = 3.14
yazdır(o, o32, o16)
yazdır(0.1 + 0.2)
yazdır(7 / 2, 7 % 2, 7.0 / 2)
değişken k = a + 10
yazdır(k)
değişken genis: Tam(32) = a
yazdır(genis + 1000)
değişken dar = 300 olarak Tam(16)
yazdır(dar)
yazdır(3.99 olarak Tam, (-3.99) olarak Tam)
yazdır(5 olarak Ondalık)
değişken karisik = 2 * 1.5
yazdır(karisik)
yazdır(-a)
yazdır(1_000_000)
